{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node website/build.mjs",
  "outputDirectory": "website-dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/play/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.(html|js|pck|wasm)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
